# Server Configuration
PORT=4000
NODE_ENV=production
# In production, set to your frontend domain(s) (comma-separated if multiple):
# CORS_ORIGIN=https://repoanalyzer.vercel.app,http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Database Configuration (Local MongoDB or MongoDB Atlas URI)
# Local: mongodb://localhost:27017/repo-analyzer
# Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/repo-analyzer?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/repo-analyzer

# GitHub API (Optional: Increases rate limit from 60 req/hr to 5,000 req/hr)
GITHUB_TOKEN=

# Google Gemini API Configuration (Optional: Enables AI synthesis; gracefully falls back if omitted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Frontend Configuration (Used by apps/web to connect to Express API)
# In production: NEXT_PUBLIC_API_URL=https://api.repoanalyzer.com
NEXT_PUBLIC_API_URL=http://localhost:4000
